{
  "name": "dsh-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone side conversations for DeepSeek Harness: open a real, continuable child session that shares the current folder and, optionally, the project's memory.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "chat",
    "side-conversation",
    "subagent"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
